# Supabase (Base de données)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Sumup (Paiement - 1,39% commission)
SUMUP_API_KEY=your_sumup_api_key
SUMUP_MERCHANT_CODE=your_merchant_code
SUMUP_WEBHOOK_SECRET=your_webhook_secret

# Mode Test (Simulateur de paiement)
# true = Mode test avec simulateur (aucun appel API réel)
# false = Mode production avec vraie API Sumup
SUMUP_TEST_MODE=true

# URL publique du site
# En local: http://localhost:3000
# En production: https://votre-domaine.vercel.app
NEXT_PUBLIC_URL=http://localhost:3000

# Resend (Envoi d'emails)
RESEND_API_KEY=your_resend_api_key
# Email du fleuriste pour recevoir les notifications de commandes
FLORIST_EMAIL=contact@example.com
